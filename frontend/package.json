{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:e2e": "node scripts/run-playwright-dev-server.mjs",
    "build": "astro build && node -e \"require('fs').writeFileSync('dist/.build-commit', require('child_process').execSync('git describe --always').toString().trim())\"",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{ts,js,svelte,astro,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,svelte,astro,css,json}\"",
    "validate:html": "node scripts/validate-build-html.mjs",
    "compare:dom": "node scripts/compare-build-dom.mjs",
    "test:e2e:smoke": "playwright test --config=playwright.config.ts",
    "test:e2e:integration": "playwright test --config=playwright.integration.config.ts",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "prepare": "cd .. && husky frontend/.husky || true"
  },
  "lint-staged": {
    "*.{ts,js,svelte,astro,css,json}": "prettier --write"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/svelte": "^9.0.1",
    "@tailwindcss/vite": "^4.2.0",
    "astro": "^7.2.1",
    "svelte": "^5.53.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.13.3",
    "html-validate": "^10.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "parse5": "^8.0.1",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1"
  },
  "overrides": {
    "yaml": "^2.8.3"
  }
}
