---
/**
 * ヘルプページ
 *
 * Narou.rb MODの使い方やドキュメントを表示
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.svelte";
import ServerStoppedBanner from "../components/ServerStoppedBanner.svelte";
import ConsolePanel from "../components/ConsolePanel.svelte";
import Footer from "../components/Footer.svelte";
---

<BaseLayout title="Narou.rb MOD - ヘルプ">
  <div class="min-h-screen flex flex-col">
    <Header client:load />
    <ServerStoppedBanner client:load />
    <main class="container mx-auto px-2.5 py-6 flex-1">
      <div class="max-w-4xl mx-auto">
        <!-- ヘッダー -->
        <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:gap-4">
          <h1
            class="text-3xl font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2"
          >
            <i class="fas fa-question-circle"></i>
            ヘルプ
          </h1>
          <p class="text-gray-600 dark:text-gray-400 mt-1 sm:mt-0">
            Narou.rb MODの使い方とドキュメント
          </p>
        </div>

        <!-- Under Construction メッセージ -->
        <div
          class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-8 text-center"
        >
          <div class="mb-4">
            <i
              class="fas fa-hard-hat text-6xl text-yellow-600 dark:text-yellow-400"
            ></i>
          </div>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-3">
            Under Construction
          </h2>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            このページは現在準備中です。
          </p>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            詳細なヘルプドキュメントは順次追加していく予定です。
          </p>
        </div>

        <!-- 仮コンテンツ: クイックリンク -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <h3
              class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3"
            >
              <i class="fas fa-book mr-2"></i>
              基本的な使い方
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
              Narou.rb MODの基本的な機能と使い方について
            </p>
            <span class="text-xs text-gray-500 dark:text-gray-500"
              >準備中...</span
            >
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <h3
              class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3"
            >
              <i class="fas fa-cog mr-2"></i>
              設定ガイド
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
              各種設定項目の詳細な説明
            </p>
            <span class="text-xs text-gray-500 dark:text-gray-500"
              >準備中...</span
            >
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <h3
              class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3"
            >
              <i class="fas fa-lightbulb mr-2"></i>
              Tips &amp; Tricks
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
              便利な使い方やヒント集
            </p>
            <span class="text-xs text-gray-500 dark:text-gray-500"
              >準備中...</span
            >
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            <h3
              class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3"
            >
              <i class="fas fa-bug mr-2"></i>
              トラブルシューティング
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
              よくある問題と解決方法
            </p>
            <span class="text-xs text-gray-500 dark:text-gray-500"
              >準備中...</span
            >
          </div>
        </div>

        <!-- 外部リンク -->
        <div
          class="mt-8 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-6"
        >
          <h3
            class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3"
          >
            <i class="fas fa-external-link-alt mr-2"></i>
            関連リンク
          </h3>
          <ul class="space-y-2">
            <li>
              <a
                href="https://github.com/whiteleaf7/narou"
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-600 dark:text-blue-400 hover:underline"
              >
                <i class="fab fa-github mr-1"></i>
                Narou.rb オリジナル版 (GitHub)
              </a>
            </li>
          </ul>
        </div>
      </div>
    </main>
    <ConsolePanel client:only="svelte" />
    <Footer client:load />
  </div>
</BaseLayout>
