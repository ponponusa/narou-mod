---
/**
 * 基本レイアウトコンポーネント
 *
 * 全ページで共通のレイアウトを提供
 */
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Narou.rb MOD - Web UI",
  description = "小説家になろうのダウンロード・変換ツール",
} = Astro.props;
const fontAwesomeIntegrity =
  process.env.NAROU_E2E_DISABLE_SRI === "true"
    ? undefined
    : "sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ==";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/logo_icon.svg" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css"
      integrity={fontAwesomeIntegrity}
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Google Font: Stack Sans Headline -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Stack+Sans+Headline:wght@700&display=swap"
      rel="stylesheet"
    />

    <!-- テーマ初期化スクリプト（ちらつき防止のため最初に実行） -->
    <script is:inline>
      // LocalStorageからテーマを復元（デフォルトはライトモード）
      const savedTheme = localStorage.getItem("theme");
      if (savedTheme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        // 明示的にライトモードまたは未設定の場合はdarkクラスを削除
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100">
    <slot />
  </body>
</html>
